@@ -0,0 +1,74 @@
+/** DesktopAutostartController behavior: bridge reads/writes, failure and concurrency guards. */
+import { describe, expect, it, vi } from 'vitest'
+import type { DesktopShellBridge } from '../src/client/desktop-shell-bridge.ts'
+import { DesktopAutostartController } from '../src/client/auto-start-controller.ts'
+
+function bridge(overrides: Partial<DesktopShellBridge> = {}): DesktopShellBridge {
+  return {
+    getAutoStart: vi.fn(async () => false),
+    setAutoStart: vi.fn(async (enabled: boolean) => enabled),
+    ...overrides,
+  }
+}
+
+describe('DesktopAutostartController', () => {
+  it('loads the current registration into a ready snapshot', async () => {
+    const shell = bridge({ getAutoStart: vi.fn(async () => true) })
+    const controller = new DesktopAutostartController(shell)
+    expect(controller.store.getSnapshot()).toEqual({
+      status: 'loading', enabled: false, saving: false, error: false,
+    })
+    await controller.load()
+    expect(shell.getAutoStart).toHaveBeenCalledOnce()
+    expect(controller.store.getSnapshot()).toEqual({
+      status: 'ready', enabled: true, saving: false, error: false,
+    })
+  })
+
+  it('keeps the row inert and reports a read failure as a localized error', async () => {
+    const shell = bridge({ getAutoStart: vi.fn(async () => { throw new Error('bridge missing') }) })
+    const controller = new DesktopAutostartController(shell)
+    await controller.load()
+    expect(controller.store.getSnapshot()).toEqual({
+      status: 'ready', enabled: false, saving: false, error: true,
+    })
+  })
+
+  it('applies a write and reflects the state the bridge reports', async () => {
+    const shell = bridge()
+    const controller = new DesktopAutostartController(shell)
+    await controller.load()
+    const pending = controller.setEnabled(true)
+    expect(controller.store.getSnapshot()).toMatchObject({ saving: true, error: false })
+    await pending
+    expect(shell.setAutoStart).toHaveBeenCalledWith(true)
+    expect(controller.store.getSnapshot()).toMatchObject({ enabled: true, saving: false })
+  })
+
+  it('collapses concurrent writes behind the in-flight one', async () => {
+    const shell = bridge({ setAutoStart: vi.fn(async (enabled: boolean) => enabled) })
+    const controller = new DesktopAutostartController(shell)
+    await controller.load()
+    const first = controller.setEnabled(true)
+    // A second gesture while saving must be a no-op.
+    await controller.setEnabled(false)
+    expect(shell.setAutoStart).toHaveBeenCalledOnce()
+    await first
+    expect(controller.store.getSnapshot().enabled).toBe(true)
+  })
+
+  it('keeps the applied value and reports a failed write', async () => {
+    const shell = bridge({ setAutoStart: vi.fn(async () => { throw new Error('denied') }) })
+    const controller = new DesktopAutostartController(shell)
+    await controller.load()
+    await controller.setEnabled(true)
+    expect(controller.store.getSnapshot()).toMatchObject({ enabled: false, saving: false, error: true })
+  })
+
+  it('ignores writes before the first read settles', async () => {
+    const shell = bridge()
+    const controller = new DesktopAutostartController(shell)
+    await controller.setEnabled(true)
+    expect(shell.setAutoStart).not.toHaveBeenCalled()
+  })
+})
