@@ -0,0 +1,28 @@
+/**
+ * Desktop-shell bridge contract: the API the Electron wrapper's preload
+ * exposes as `window.__dshDesktopShell`. Absent in every plain browser, so
+ * rows that depend on it register only when the page runs inside the shell.
+ */
+
+/** Start-at-login control provided by the host desktop shell. */
+export interface DesktopShellBridge {
+  /** Whether the desktop app is registered to start when the user signs in. */
+  getAutoStart(): Promise<boolean>
+  /** Register or unregister start-at-login; resolves with the applied state. */
+  setAutoStart(enabled: boolean): Promise<boolean>
+}
+
+declare global {
+  interface Window {
+    /** Installed by the DeepSeek Harness Desktop preload; absent otherwise. */
+    __dshDesktopShell?: DesktopShellBridge
+  }
+}
+
+/**
+ * Read the bridge installed by the desktop shell, if the page runs inside one.
+ * @returns the shell bridge, or undefined in a plain browser or Node.
+ */
+export function readDesktopShellBridge(): DesktopShellBridge | undefined {
+  return typeof window === 'undefined' ? undefined : window.__dshDesktopShell
+}
