@@ -0,0 +1,59 @@
+/** General Settings row for starting the desktop app at login (desktop shell only). */
+
+import { useEffect } from 'react'
+import type { ReactNode } from 'react'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { DesktopAutostartController } from './auto-start-controller.ts'
+import css from './AutoStartRow.module.css'
+
+/** Registrant-owned dependencies of {@link AutoStartRow}. */
+export interface AutoStartRowInjected {
+  /** Registration state owner and bridge caller. */
+  controller: DesktopAutostartController
+  hooks: {
+    /** Controller snapshot bound by the UI renderer as useSnapshot. */
+    snapshot: DesktopAutostartController['store']
+  }
+}
+
+/** General-item owner share, localized copy, and the registrant's state face. */
+export type AutoStartRowProps =
+  PropsRuntime<'settings.general.item'> & PropsLocale<'settings'> & InjectFace<AutoStartRowInjected>
+
+/**
+ * Render the start-at-login switch. The row exists only while the page runs
+ * inside the desktop shell (the register branch in apply), so the shell's
+ * bridge is always present here.
+ * @param props - composed slot props.
+ * @returns the preference row.
+ */
+export function AutoStartRow({ controller, useSnapshot, t }: AutoStartRowProps): ReactNode {
+  const state = useSnapshot(snapshot => snapshot)
+
+  useEffect(() => {
+    void controller.load()
+  }, [controller])
+
+  const inert = state.status !== 'ready' || state.saving
+
+  return (
+    <div className={css.row}>
+      <div className={css.rowText}>
+        <div className={css.title}>{t('autoStart.title')}</div>
+        <div className={css.desc}>{t('autoStart.description')}</div>
+        {state.error ? <div className={css.error} role="alert">{t('autoStart.error')}</div> : null}
+      </div>
+      <button
+        type="button"
+        role="switch"
+        aria-checked={state.enabled}
+        aria-label={t('autoStart.title')}
+        className={state.enabled ? `${css.switch} ${css.switchOn}` : css.switch}
+        disabled={inert}
+        onClick={() => { void controller.setEnabled(!state.enabled) }}
+      >
+        <span className={css.thumb} />
+      </button>
+    </div>
+  )
+}
