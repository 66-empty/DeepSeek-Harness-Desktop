+// @vitest-environment jsdom
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { bindSnapshotSelector } from '@deepseek-ai/dsh-client-test-runtime'
+import type { AutoStartRowProps } from '../src/client/AutoStartRow.tsx'
+import { AutoStartRow } from '../src/client/AutoStartRow.tsx'
+import { DesktopAutostartController } from '../src/client/auto-start-controller.ts'
+import { en } from '../src/client/locales.ts'
+
+afterEach(cleanup)
+
+// The seat's key domain is settings ∪ common; the stub answers from the
+// package dictionary and falls back to the key like the real chain.
+const t: AutoStartRowProps['t'] = key => (en as Record<string, string>)[key] ?? key
+
+// Global standard kit stubs: the item seat's owner share is empty and the
+// row consumes none of these hooks.
+const unusedHook = (() => { throw new Error('unused by AutoStartRow') }) as never
+type AttentionSnapshot = Parameters<Parameters<AutoStartRowProps['useSessionPendingInteraction']>[0]>[0]
+const noAttention: AttentionSnapshot = new Map()
+const useSessionPendingInteraction: AutoStartRowProps['useSessionPendingInteraction'] = selector => selector(noAttention)
+const kit = { useSessions: unusedHook, useSessionPendingInteraction, useWorkspaces: unusedHook }
+
+function mount(controller: DesktopAutostartController) {
+  return render(<AutoStartRow
+    {...kit}
+    t={t}
+    controller={controller}
+    useSnapshot={bindSnapshotSelector(controller.store)}
+  />)
+}
+
+describe('AutoStartRow', () => {
+  it('renders an inert switch until the registration read lands, then the applied state', async () => {
+    const controller = new DesktopAutostartController({
+      getAutoStart: vi.fn(async () => true),
+      setAutoStart: vi.fn(async (enabled: boolean) => enabled),
+    })
+    mount(controller)
+    const before = screen.getByRole('switch', { name: 'Start at login' })
+    expect(before.getAttribute('aria-checked')).toBe('false')
+    expect((before as HTMLButtonElement).disabled).toBe(true)
+    await waitFor(() => { expect(controller.store.getSnapshot().status).toBe('ready') })
+    const after = screen.getByRole('switch', { name: 'Start at login' })
+    expect(after.getAttribute('aria-checked')).toBe('true')
+    expect((after as HTMLButtonElement).disabled).toBe(false)
+    expect(screen.getByText('Start at login')).toBeTruthy()
+    expect(screen.getByText(/Launch DeepSeek Harness in the background/)).toBeTruthy()
+  })
+
+  it('writes the opposite state on click and disables while the write is in flight', async () => {
+    let resolveWrite: ((enabled: boolean) => void) | undefined
+    const setAutoStart = vi.fn(() => new Promise<boolean>((resolve) => { resolveWrite = resolve }))
+    const controller = new DesktopAutostartController({
+      getAutoStart: vi.fn(async () => true),
+      setAutoStart,
+    })
+    mount(controller)
+    await waitFor(() => { expect(controller.store.getSnapshot().status).toBe('ready') })
+    const toggle = screen.getByRole('switch', { name: 'Start at login' })
+    fireEvent.click(toggle)
+    expect(setAutoStart).toHaveBeenCalledWith(false)
+    expect((screen.getByRole('switch', { name: 'Start at login' }) as HTMLButtonElement).disabled).toBe(true)
+    resolveWrite!(false)
+    await waitFor(() => {
+      expect(controller.store.getSnapshot().enabled).toBe(false)
+    })
+    expect((screen.getByRole('switch', { name: 'Start at login' }) as HTMLButtonElement).disabled).toBe(false)
+  })
+
+  it('keeps the last applied value and shows a localized error when the write fails', async () => {
+    const controller = new DesktopAutostartController({
+      getAutoStart: vi.fn(async () => true),
+      setAutoStart: vi.fn(async () => { throw new Error('denied') }),
+    })
+    mount(controller)
+    await waitFor(() => { expect(controller.store.getSnapshot().status).toBe('ready') })
+    fireEvent.click(screen.getByRole('switch', { name: 'Start at login' }))
+    expect((await screen.findByRole('alert')).textContent).toBe('Could not update the start-at-login setting')
+    expect(screen.getByRole('switch', { name: 'Start at login' }).getAttribute('aria-checked')).toBe('true')
+  })
+
+  it('shows the localized error when the registration read fails', async () => {
+    const controller = new DesktopAutostartController({
+      getAutoStart: vi.fn(async () => { throw new Error('bridge missing') }),
+      setAutoStart: vi.fn(async (enabled: boolean) => enabled),
+    })
+    mount(controller)
+    expect((await screen.findByRole('alert')).textContent).toBe('Could not update the start-at-login setting')
+    expect((screen.getByRole('switch', { name: 'Start at login' }) as HTMLButtonElement).disabled).toBe(false)
+  })
+})
