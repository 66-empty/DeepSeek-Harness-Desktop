@@ -0,0 +1,83 @@
+/** State owner for the desktop-shell start-at-login row. */
+
+import { createSnapshotStore, type SnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { DesktopShellBridge } from './desktop-shell-bridge.ts'
+
+/** Browser state of the host desktop shell's start-at-login registration. */
+export interface AutoStartState {
+  /** Bridge read phase; the switch stays inert until the first read lands. */
+  status: 'loading' | 'ready'
+  /** Whether start-at-login is currently registered on the host. */
+  enabled: boolean
+  /** Whether one registration write is in flight. */
+  saving: boolean
+  /** Whether the last bridge call failed; the UI renders only localized copy. */
+  error: boolean
+}
+
+/**
+ * Reads and writes the desktop shell's start-at-login registration through
+ * the preload bridge; the switch is inert until the first read settles.
+ */
+export class DesktopAutostartController {
+  /** uSES-safe state source shared by the registered row. */
+  readonly store: SnapshotStore<AutoStartState> = createSnapshotStore({
+    status: 'loading', enabled: false, saving: false, error: false,
+  })
+
+  /**
+   * @param bridge - the preload bridge installed by the desktop shell.
+   */
+  constructor(private readonly bridge: DesktopShellBridge) {}
+
+  /**
+   * Read the current registration once; failures surface as a localized error
+   * with the switch disabled rather than an unhandled rejection.
+   * @returns after the bridge read settles.
+   */
+  async load(): Promise<void> {
+    try {
+      const enabled = await this.bridge.getAutoStart()
+      this.store.update((state) => {
+        state.status = 'ready'
+        state.enabled = enabled
+        state.error = false
+      })
+    } catch {
+      this.store.update((state) => {
+        state.status = 'ready'
+        state.enabled = false
+        state.error = true
+      })
+    }
+  }
+
+  /**
+   * Apply one registration change; concurrent gestures collapse behind the
+   * in-flight write, and a failed write keeps the last applied value.
+   * @param enabled - the registration state to apply.
+   * @returns after the bridge write settles.
+   */
+  async setEnabled(enabled: boolean): Promise<void> {
+    const current = this.store.getSnapshot()
+    if (current.status !== 'ready' || current.saving) return
+    this.store.update((state) => {
+      state.saving = true
+      state.error = false
+    })
+    try {
+      const applied = await this.bridge.setAutoStart(enabled)
+      this.store.update((state) => {
+        state.enabled = applied
+      })
+    } catch {
+      this.store.update((state) => {
+        state.error = true
+      })
+    } finally {
+      this.store.update((state) => {
+        state.saving = false
+      })
+    }
+  }
+}
